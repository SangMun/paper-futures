# Keep the real webhook URL only in .env.
# 아래 3개를 설정하면 알림 종류별로 다른 디스코드 채널을 쓴다.
DISCORD_SYSTEM_WEBHOOK_URL=
DISCORD_BTC_TRADE_WEBHOOK_URL=
DISCORD_XRP_TRADE_WEBHOOK_URL=
DISCORD_BALANCE_WEBHOOK_URL=

# 기존 단일 매매 채널·전체 채널 호환용.
# BTC/XRP 전용 URL이 없으면 TRADE URL로, 그것도 없으면
# 전체 WEBHOOK URL로 보낸다.
DISCORD_TRADE_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
