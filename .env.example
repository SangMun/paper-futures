# Keep the real webhook URL only in .env.
# 아래 3개를 설정하면 알림 종류별로 다른 디스코드 채널을 쓴다.
DISCORD_SYSTEM_WEBHOOK_URL=
DISCORD_BTC_TRADE_WEBHOOK_URL=
DISCORD_XRP_TRADE_WEBHOOK_URL=
DISCORD_BALANCE_WEBHOOK_URL=

# EXP-015 XRP 양방향 페이퍼의 4개 독립 알림 채널.
DISCORD_XRP_DUAL_HEDGE_50_CONTINUOUS_WEBHOOK_URL=
DISCORD_XRP_DUAL_HEDGE_50_SQUEEZE_WEBHOOK_URL=
DISCORD_XRP_DUAL_HEDGE_100_CONTINUOUS_WEBHOOK_URL=
DISCORD_XRP_DUAL_HEDGE_100_SQUEEZE_WEBHOOK_URL=

# 기존 단일 매매 채널·전체 채널 호환용.
# BTC/XRP 전용 URL이 없으면 TRADE URL로, 그것도 없으면
# 전체 WEBHOOK URL로 보낸다.
DISCORD_TRADE_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# 계좌를 전략별로 나눌 때 (deploy/paper-futures@.service)
#
# 인스턴스 이름마다 .env.<이름> 파일을 하나씩 둔다. 예: .env.btc25x
# 잔고·시작·종료 메시지가 계좌마다 따로 오므로 계좌당 디스코드 채널
# 하나를 만들어 DISCORD_WEBHOOK_URL 에 넣는 게 가장 단순하다.
#
#   .env.btc25x
#     PAPER_STRATEGIES=btc_regime_25x
#     DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...   # #paper-btc-25x
#
#   .env.btcchan
#     PAPER_STRATEGIES=btc_regression_channel
#     DISCORD_WEBHOOK_URL=...                                     # #paper-btc-channel
#
#   .env.xrp
#     PAPER_STRATEGIES=xrp_patterns
#     DISCORD_WEBHOOK_URL=...                                     # #paper-xrp
#
# PAPER_STRATEGIES 는 쉼표 구분 접두사 목록. 전략 이름은 engine/loop.py
# build_strategies() 참조. PAPER_ACCOUNT / PAPER_DATA_DIR 은 서비스 파일이 넣는다.
PAPER_STRATEGIES=
