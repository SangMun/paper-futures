[Unit]
Description=XRP dual hedge 50x/100x paper experiment
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/paper-futures/v2

# Four experiment-specific Discord URLs live only on the Lightsail instance.
EnvironmentFile=/home/ubuntu/paper-futures/v2/.env.xrp-dual-hedge
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/paper-futures/v2/.venv/bin/python -m tools.paper_xrp_dual_hedge_live --minutes 0 --poll-50-seconds 5 --poll-100-seconds 1 --log-dir data/xrp_dual_hedge_mark_live --liq-stop-buffer 0.001

# SIGINT follows the tool's normal shutdown path and leaves its JSON state intact.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
