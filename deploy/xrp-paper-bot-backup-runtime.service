[Unit]
Description=Back up paper-bot runtime state and logs to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/xrp-paper-bot/v2
EnvironmentFile=/etc/xrp-paper-bot/backup.env
ExecStart=/home/ubuntu/xrp-paper-bot/v2/deploy/backup-to-s3.sh runtime

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077
