[Unit]
Description=Refresh and back up paper-bot market data to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/paper-futures/v2
EnvironmentFile=/etc/paper-futures/backup.env
ExecStart=/home/ubuntu/paper-futures/v2/deploy/backup-to-s3.sh market

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077
